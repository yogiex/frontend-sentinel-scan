/**
 * SentinelScan New Scan Page (Refactored)
 * Path: src/pages/Dashboard/Scans/NewScan.tsx
 *
 * Create a new vulnerability scan form with improved UI/UX using shadcn/ui.
 * Uses react-hook-form + zod for validation.
 */
import { useNavigate } from "react-router-dom";
import { useForm } from "react-hook-form";
import { zodResolver } from "@hookform/resolvers/zod";
import { z } from "zod";
import {
  Card,
  CardContent,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Textarea } from "@/components/ui/textarea";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import {
  Form,
  FormField,
  FormItem,
  FormLabel,
  FormControl,
  FormMessage,
  FormDescription,
} from "@/components/ui/form";
import { Switch } from "@/components/ui/switch";
import { RadioGroup, RadioGroupItem } from "@/components/ui/radio-group";
import { X, Plus } from "lucide-react";

/* ────────── Static Options ────────── */
const scanTypes = [
  {
    value: "basic",
    label: "Basic Network Scan",
    desc: "Standard vulnerability scan — CVE detection, service enumeration, misconfigurations",
  },
  {
    value: "advanced",
    label: "Advanced Scan",
    desc: "Custom plugin selection, specific ports, targeted checks",
  },
  {
    value: "web",
    label: "Web Application Scan",
    desc: "OWASP Top 10, SQLi, XSS, authentication flaws",
  },
  {
    value: "credentialed",
    label: "Credentialed Patch Audit",
    desc: "Deep scan with SSH/Windows credentials — missing patches, local vulns",
  },
  {
    value: "compliance",
    label: "Compliance Audit",
    desc: "CIS benchmarks, PCI-DSS, HIPAA, DISA STIG policy checks",
  },
  {
    value: "discovery",
    label: "Host Discovery",
    desc: "Network mapping, port scanning, OS fingerprinting only",
  },
];

const scanProfiles = [
  { value: "quick", label: "Quick", desc: "Fast scan — common CVEs, top 1000 ports only" },
  {
    value: "standard",
    label: "Standard",
    desc: "Balanced — full port range, comprehensive plugin set",
  },
  {
    value: "full",
    label: "Full",
    desc: "Thorough — all plugins, deep checks, longer duration",
  },
  { value: "custom", label: "Custom", desc: "Manual plugin and port selection" },
];

const authMethods = [
  { value: "basic", label: "Basic Auth (Key-Value Pairs)" },
  { value: "jwt", label: "JWT Token" },
  { value: "cookie", label: "Cookie-based Auth" },
  { value: "selenium", label: "Selenium (Browser Automation)" },
];

const userAgentOptions = [
  {
    value: "random",
    label: "Random (Rotate per request)",
    desc: "Randomize User-Agent from pool of real browsers",
  },
  {
    value: "chrome",
    label: "Chrome (Latest)",
    desc: "Mozilla/5.0 ... Chrome/120.0 ...",
  },
  {
    value: "firefox",
    label: "Firefox (Latest)",
    desc: "Mozilla/5.0 ... Firefox/121.0 ...",
  },
  {
    value: "safari",
    label: "Safari (macOS)",
    desc: "Mozilla/5.0 ... Safari/605.1 ...",
  },
  {
    value: "edge",
    label: "Edge (Windows)",
    desc: "Mozilla/5.0 ... Edg/120.0 ...",
  },
  { value: "custom", label: "Custom", desc: "Define your own User-Agent string" },
];

/* ────────── Zod Schema ────────── */
const newScanSchema = z.object({
  target: z.string().min(1, "Target is required"),
  scanType: z.string().min(1, "Scan type is required"),
  profile: z.string().min(1, "Profile is required"),
  schedule: z.enum(["now", "schedule"]).default("now"),
  scheduledDate: z.string().optional(),
  useCredentials: z.boolean().default(false),
  authType: z.string().optional(),
  keyValuePairs: z
    .array(z.object({ key: z.string(), value: z.string() }))
    .default([]),
  username: z.string().optional(),
  password: z.string().optional(),
  privateKey: z.string().optional(),
  description: z.string().max(500, "Max 500 characters").optional(),

  // Stealth options
  userAgentMode: z.string().default("random"),
  customUserAgent: z.string().optional(),
  enableCookies: z.boolean().default(true),
  humanLikeDelay: z.boolean().default(true),
  delayMin: z.number().default(1),
  delayMax: z.number().default(5),
  randomizeOrder: z.boolean().default(true),
});

type NewScanForm = z.infer<typeof newScanSchema>;

/* ────────── Component ────────── */
export function NewScan() {
  const navigate = useNavigate();

  const form = useForm<NewScanForm>({
    resolver: zodResolver(newScanSchema),
    defaultValues: {
      target: "",
      scanType: "",
      profile: "",
      schedule: "now",
      scheduledDate: "",
      useCredentials: false,
      authType: "",
      keyValuePairs: [],
      username: "",
      password: "",
      privateKey: "",
      description: "",
      userAgentMode: "random",
      customUserAgent: "",
      enableCookies: true,
      humanLikeDelay: true,
      delayMin: 1,
      delayMax: 5,
      randomizeOrder: true,
    },
  });

  // Watchers untuk conditional rendering
  const watchSchedule = form.watch("schedule");
  const watchUseCredentials = form.watch("useCredentials");
  const watchAuthType = form.watch("authType");
  const watchScanType = form.watch("scanType");
  const watchProfile = form.watch("profile");
  const watchUserAgentMode = form.watch("userAgentMode");
  const watchHumanLikeDelay = form.watch("humanLikeDelay");
  const watchEnableCookies = form.watch("enableCookies");
  const watchRandomizeOrder = form.watch("randomizeOrder");
  const descriptionValue = form.watch("description") || "";

  const onSubmit = (data: NewScanForm) => {
    console.log("New scan submitted:", data);
    // TODO: Call API to create scan
    navigate("/dashboard/scans/all");
  };

  return (
    <div className="space-y-6">
      {/* Page Header */}
      <div>
        <h1 className="text-2xl font-bold text-white">New Scan</h1>
        <p className="text-slate-400 mt-1">
          Configure and launch a new vulnerability scan
        </p>
      </div>

      <Form {...form}>
        <form onSubmit={form.handleSubmit(onSubmit)} className="space-y-6">
          {/* Two‑column layout on large screens */}
          <div className="grid grid-cols-1 xl:grid-cols-2 gap-6">
            {/* ── Left Column ── */}
            <div className="space-y-6">
              {/* Target */}
              <Card className="bg-slate-900 border-slate-800">
                <CardHeader className="pb-3">
                  <CardTitle className="text-lg text-white">Target</CardTitle>
                </CardHeader>
                <CardContent>
                  <FormField
                    control={form.control}
                    name="target"
                    render={({ field }) => (
                      <FormItem>
                        <FormLabel className="text-slate-300">
                          Target Address
                        </FormLabel>
                        <FormControl>
                          <Input
                            placeholder="e.g. 192.168.1.0/24, example.com, 10.0.0.1"
                            className="bg-slate-800 border-slate-700 text-white placeholder:text-slate-500"
                            {...field}
                          />
                        </FormControl>
                        <FormDescription className="text-slate-500">
                          IP address, CIDR range, or domain name
                        </FormDescription>
                        <FormMessage />
                      </FormItem>
                    )}
                  />
                </CardContent>
              </Card>

              {/* Configuration */}
              <Card className="bg-slate-900 border-slate-800">
                <CardHeader className="pb-3">
                  <CardTitle className="text-lg text-white">
                    Configuration
                  </CardTitle>
                </CardHeader>
                <CardContent className="space-y-4">
                  <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                      <FormField
                        control={form.control}
                        name="scanType"
                        render={({ field }) => (
                          <FormItem>
                            <FormLabel className="text-slate-300">
                              Scan Type
                            </FormLabel>
                            <Select
                              onValueChange={field.onChange}
                              defaultValue={field.value}
                            >
                              <FormControl>
                                <SelectTrigger className="bg-slate-800 border-slate-700 text-white">
                                  <SelectValue placeholder="Select type..." />
                                </SelectTrigger>
                              </FormControl>
                              <SelectContent className="bg-slate-800 border-slate-700 text-white">
                                {scanTypes.map((t) => (
                                  <SelectItem key={t.value} value={t.value}>
                                    {t.label}
                                  </SelectItem>
                                ))}
                              </SelectContent>
                            </Select>
                            {watchScanType && (
                              <p className="text-xs text-slate-500 mt-1">
                                {
                                  scanTypes.find(
                                    (t) => t.value === watchScanType
                                  )?.desc
                                }
                              </p>
                            )}
                            <FormMessage />
                          </FormItem>
                        )}
                      />
                    </div>
                    <div>
                      <FormField
                        control={form.control}
                        name="profile"
                        render={({ field }) => (
                          <FormItem>
                            <FormLabel className="text-slate-300">
                              Scan Profile
                            </FormLabel>
                            <Select
                              onValueChange={field.onChange}
                              defaultValue={field.value}
                            >
                              <FormControl>
                                <SelectTrigger className="bg-slate-800 border-slate-700 text-white">
                                  <SelectValue placeholder="Select profile..." />
                                </SelectTrigger>
                              </FormControl>
                              <SelectContent className="bg-slate-800 border-slate-700 text-white">
                                {scanProfiles.map((p) => (
                                  <SelectItem key={p.value} value={p.value}>
                                    {p.label}
                                  </SelectItem>
                                ))}
                              </SelectContent>
                            </Select>
                            {watchProfile && (
                              <p className="text-xs text-slate-500 mt-1">
                                {
                                  scanProfiles.find(
                                    (p) => p.value === watchProfile
                                  )?.desc
                                }
                              </p>
                            )}
                            <FormMessage />
                          </FormItem>
                        )}
                      />
                    </div>
                  </div>

                  {/* Schedule */}
                  <FormField
                    control={form.control}
                    name="schedule"
                    render={({ field }) => (
                      <FormItem className="space-y-3">
                        <FormLabel className="text-slate-300">
                          Schedule
                        </FormLabel>
                        <FormControl>
                          <RadioGroup
                            onValueChange={field.onChange}
                            defaultValue={field.value}
                            className="flex gap-4"
                          >
                            <div className="flex items-center space-x-2">
                              <RadioGroupItem
                                value="now"
                                id="schedule-now"
                                className="border-slate-600 text-blue-500"
                              />
                              <label
                                htmlFor="schedule-now"
                                className="text-sm text-slate-300 cursor-pointer"
                              >
                                Run Now
                              </label>
                            </div>
                            <div className="flex items-center space-x-2">
                              <RadioGroupItem
                                value="schedule"
                                id="schedule-later"
                                className="border-slate-600 text-blue-500"
                              />
                              <label
                                htmlFor="schedule-later"
                                className="text-sm text-slate-300 cursor-pointer"
                              >
                                Schedule
                              </label>
                            </div>
                          </RadioGroup>
                        </FormControl>
                      </FormItem>
                    )}
                  />

                  {watchSchedule === "schedule" && (
                    <FormField
                      control={form.control}
                      name="scheduledDate"
                      render={({ field }) => (
                        <FormItem>
                          <FormLabel className="text-slate-300">
                            Schedule Date & Time
                          </FormLabel>
                          <FormControl>
                            <Input
                              type="datetime-local"
                              className="bg-slate-800 border-slate-700 text-white"
                              {...field}
                            />
                          </FormControl>
                          <FormMessage />
                        </FormItem>
                      )}
                    />
                  )}
                </CardContent>
              </Card>

              {/* Notes */}
              <Card className="bg-slate-900 border-slate-800">
                <CardHeader className="pb-3">
                  <CardTitle className="text-lg text-white">Notes</CardTitle>
                </CardHeader>
                <CardContent>
                  <FormField
                    control={form.control}
                    name="description"
                    render={({ field }) => (
                      <FormItem>
                        <FormControl>
                          <Textarea
                            placeholder="Optional description or notes for this scan..."
                            className="bg-slate-800 border-slate-700 text-white placeholder:text-slate-500 resize-none"
                            rows={3}
                            {...field}
                          />
                        </FormControl>
                        <FormDescription className="text-slate-500">
                          {descriptionValue.length}/500 characters
                        </FormDescription>
                        <FormMessage />
                      </FormItem>
                    )}
                  />
                </CardContent>
              </Card>
            </div>

            {/* ── Right Column ── */}
            <div className="space-y-6">
              {/* Stealth Options */}
              <Card className="bg-slate-900 border-slate-800">
                <CardHeader className="pb-3">
                  <CardTitle className="text-lg text-white">
                    Stealth Options
                  </CardTitle>
                  <p className="text-xs text-slate-500">
                    Anti-detection settings to avoid WAF/IDS blocking
                  </p>
                </CardHeader>
                <CardContent className="space-y-4">
                  {/* User-Agent Strategy */}
                  <FormField
                    control={form.control}
                    name="userAgentMode"
                    render={({ field }) => (
                      <FormItem>
                        <FormLabel className="text-slate-300">
                          User-Agent Strategy
                        </FormLabel>
                        <Select
                          onValueChange={field.onChange}
                          defaultValue={field.value}
                        >
                          <FormControl>
                            <SelectTrigger className="bg-slate-800 border-slate-700 text-white">
                              <SelectValue placeholder="Select strategy..." />
                            </SelectTrigger>
                          </FormControl>
                          <SelectContent className="bg-slate-800 border-slate-700 text-white">
                            {userAgentOptions.map((u) => (
                              <SelectItem key={u.value} value={u.value}>
                                {u.label}
                              </SelectItem>
                            ))}
                          </SelectContent>
                        </Select>
                        {watchUserAgentMode && (
                          <p className="text-xs text-slate-500 mt-1">
                            {
                              userAgentOptions.find(
                                (u) => u.value === watchUserAgentMode
                              )?.desc
                            }
                          </p>
                        )}
                        <FormMessage />
                      </FormItem>
                    )}
                  />

                  {/* Custom User-Agent */}
                  {watchUserAgentMode === "custom" && (
                    <FormField
                      control={form.control}
                      name="customUserAgent"
                      render={({ field }) => (
                        <FormItem>
                          <FormLabel className="text-slate-300">
                            Custom User-Agent
                          </FormLabel>
                          <FormControl>
                            <Input
                              placeholder="Mozilla/5.0 (Windows NT 10.0; Win64; x64) ..."
                              className="bg-slate-800 border-slate-700 text-white placeholder:text-slate-500 font-mono text-xs"
                              {...field}
                            />
                          </FormControl>
                          <FormMessage />
                        </FormItem>
                      )}
                    />
                  )}

                  {/* Toggle switches */}
                  <div className="space-y-3 pt-2 border-t border-slate-800">
                    {/* Session Cookies */}
                    <div className="flex items-center justify-between">
                      <div>
                        <p className="text-sm text-white">Session Cookies</p>
                        <p className="text-xs text-slate-500">
                          Accept and store cookies like a real browser
                        </p>
                      </div>
                      <Switch
                        checked={watchEnableCookies}
                        onCheckedChange={(checked) =>
                          form.setValue("enableCookies", checked)
                        }
                        className="data-[state=checked]:bg-blue-600"
                      />
                    </div>

                    {/* Human-like Delays */}
                    <div className="flex items-center justify-between">
                      <div>
                        <p className="text-sm text-white">
                          Human-like Delays
                        </p>
                        <p className="text-xs text-slate-500">
                          Random delays between requests to mimic human
                          behavior
                        </p>
                      </div>
                      <Switch
                        checked={watchHumanLikeDelay}
                        onCheckedChange={(checked) =>
                          form.setValue("humanLikeDelay", checked)
                        }
                        className="data-[state=checked]:bg-blue-600"
                      />
                    </div>

                    {/* Delay range */}
                    {watchHumanLikeDelay && (
                      <div className="grid grid-cols-2 gap-4 pl-2">
                        <FormField
                          control={form.control}
                          name="delayMin"
                          render={({ field }) => (
                            <FormItem>
                              <FormLabel className="text-slate-400 text-xs">
                                Min Delay (s)
                              </FormLabel>
                              <FormControl>
                                <Input
                                  type="number"
                                  min={0}
                                  className="bg-slate-800 border-slate-700 text-white text-sm"
                                  {...field}
                                  onChange={(e) =>
                                    field.onChange(Number(e.target.value))
                                  }
                                />
                              </FormControl>
                              <FormMessage />
                            </FormItem>
                          )}
                        />
                        <FormField
                          control={form.control}
                          name="delayMax"
                          render={({ field }) => (
                            <FormItem>
                              <FormLabel className="text-slate-400 text-xs">
                                Max Delay (s)
                              </FormLabel>
                              <FormControl>
                                <Input
                                  type="number"
                                  min={0}
                                  className="bg-slate-800 border-slate-700 text-white text-sm"
                                  {...field}
                                  onChange={(e) =>
                                    field.onChange(Number(e.target.value))
                                  }
                                />
                              </FormControl>
                              <FormMessage />
                            </FormItem>
                          )}
                        />
                      </div>
                    )}

                    {/* Randomize Request Order */}
                    <div className="flex items-center justify-between">
                      <div>
                        <p className="text-sm text-white">
                          Randomize Request Order
                        </p>
                        <p className="text-xs text-slate-500">
                          Shuffle scan targets to avoid sequential patterns
                        </p>
                      </div>
                      <Switch
                        checked={watchRandomizeOrder}
                        onCheckedChange={(checked) =>
                          form.setValue("randomizeOrder", checked)
                        }
                        className="data-[state=checked]:bg-blue-600"
                      />
                    </div>
                  </div>
                </CardContent>
              </Card>

              {/* Credentials */}
              <Card className="bg-slate-900 border-slate-800">
                <CardHeader className="pb-3">
                  <div className="flex items-center justify-between">
                    <CardTitle className="text-lg text-white">
                      Credentials
                    </CardTitle>
                    <div className="flex items-center gap-2">
                      <span className="text-sm text-slate-400">
                        {watchUseCredentials ? "Enabled" : "Disabled"}
                      </span>
                      <Switch
                        checked={watchUseCredentials}
                        onCheckedChange={(checked) =>
                          form.setValue("useCredentials", checked)
                        }
                        className="data-[state=checked]:bg-blue-600"
                      />
                    </div>
                  </div>
                </CardHeader>
                {watchUseCredentials && (
                  <CardContent className="space-y-4">
                    <p className="text-sm text-slate-500">
                      Provide credentials for authenticated vulnerability
                      assessment. Credentials are encrypted and used only for
                      this scan.
                    </p>

                    {/* Auth Method */}
                    <FormField
                      control={form.control}
                      name="authType"
                      render={({ field }) => (
                        <FormItem>
                          <FormLabel className="text-slate-300">
                            Authentication Method
                          </FormLabel>
                          <Select
                            onValueChange={field.onChange}
                            defaultValue={field.value}
                          >
                            <FormControl>
                              <SelectTrigger className="bg-slate-800 border-slate-700 text-white">
                                <SelectValue placeholder="Select method..." />
                              </SelectTrigger>
                            </FormControl>
                            <SelectContent className="bg-slate-800 border-slate-700 text-white">
                              {authMethods.map((m) => (
                                <SelectItem key={m.value} value={m.value}>
                                  {m.label}
                                </SelectItem>
                              ))}
                            </SelectContent>
                          </Select>
                          <FormMessage />
                        </FormItem>
                      )}
                    />

                    {/* Dynamic Key-Value Pairs (Basic Auth) */}
                    {watchAuthType === "basic" && (
                      <div className="space-y-3">
                        <div className="flex items-center justify-between">
                          <p className="text-sm text-slate-400">
                            Add credential fields (e.g., username, password,
                            api-key)
                          </p>
                          <Button
                            type="button"
                            variant="outline"
                            size="sm"
                            className="border-slate-700 text-slate-300 hover:bg-slate-800 h-7 text-xs"
                            onClick={() => {
                              const current =
                                form.getValues("keyValuePairs") || [];
                              form.setValue("keyValuePairs", [
                                ...current,
                                { key: "", value: "" },
                              ]);
                            }}
                          >
                            <Plus className="w-3 h-3 mr-1" /> Add Field
                          </Button>
                        </div>
                        {(() => {
                          const pairs = form.watch("keyValuePairs") || [];
                          if (pairs.length === 0) {
                            return (
                              <div className="border border-dashed border-slate-700 rounded-lg p-4 text-center">
                                <p className="text-sm text-slate-500">
                                  No fields added. Click "Add Field" to start.
                                </p>
                              </div>
                            );
                          }
                          return (
                            <div className="space-y-2">
                              {pairs.map((_, index) => (
                                <div
                                  key={index}
                                  className="flex gap-2 items-start"
                                >
                                  <div className="flex-1">
                                    <Input
                                      placeholder="Key (e.g., username)"
                                      className="bg-slate-800 border-slate-700 text-white placeholder:text-slate-500"
                                      value={pairs[index]?.key || ""}
                                      onChange={(e) => {
                                        const updated = [...pairs];
                                        updated[index] = {
                                          ...updated[index],
                                          key: e.target.value,
                                        };
                                        form.setValue(
                                          "keyValuePairs",
                                          updated
                                        );
                                      }}
                                    />
                                  </div>
                                  <div className="flex-1">
                                    <Input
                                      type="password"
                                      placeholder="Value"
                                      className="bg-slate-800 border-slate-700 text-white placeholder:text-slate-500"
                                      value={pairs[index]?.value || ""}
                                      onChange={(e) => {
                                        const updated = [...pairs];
                                        updated[index] = {
                                          ...updated[index],
                                          value: e.target.value,
                                        };
                                        form.setValue(
                                          "keyValuePairs",
                                          updated
                                        );
                                      }}
                                    />
                                  </div>
                                  <Button
                                    type="button"
                                    variant="outline"
                                    size="icon"
                                    className="border-red-800 text-red-400 hover:bg-red-900/30 h-9 w-9"
                                    onClick={() => {
                                      const updated = pairs.filter(
                                        (_, i) => i !== index
                                      );
                                      form.setValue(
                                        "keyValuePairs",
                                        updated
                                      );
                                    }}
                                  >
                                    <X className="w-4 h-4" />
                                  </Button>
                                </div>
                              ))}
                            </div>
                          );
                        })()}
                        <p className="text-xs text-slate-500">
                          Common fields: username, password, api-key,
                          client_id, client_secret
                        </p>
                      </div>
                    )}

                    {/* JWT Token */}
                    {watchAuthType === "jwt" && (
                      <FormField
                        control={form.control}
                        name="privateKey"
                        render={({ field }) => (
                          <FormItem>
                            <FormLabel className="text-slate-300">
                              JWT Token
                            </FormLabel>
                            <FormControl>
                              <Textarea
                                placeholder="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                                className="bg-slate-800 border-slate-700 text-white placeholder:text-slate-500 resize-none font-mono text-xs"
                                rows={3}
                                {...field}
                              />
                            </FormControl>
                            <FormDescription className="text-slate-500">
                              Paste the full JWT token (Bearer token will be
                              auto-prefixed)
                            </FormDescription>
                            <FormMessage />
                          </FormItem>
                        )}
                      />
                    )}

                    {/* Cookie Auth */}
                    {watchAuthType === "cookie" && (
                      <div className="space-y-4">
                        <FormField
                          control={form.control}
                          name="username"
                          render={({ field }) => (
                            <FormItem>
                              <FormLabel className="text-slate-300">
                                Cookie Name
                              </FormLabel>
                              <FormControl>
                                <Input
                                  placeholder="e.g. session_id, auth_token"
                                  className="bg-slate-800 border-slate-700 text-white placeholder:text-slate-500"
                                  {...field}
                                />
                              </FormControl>
                              <FormMessage />
                            </FormItem>
                          )}
                        />
                        <FormField
                          control={form.control}
                          name="password"
                          render={({ field }) => (
                            <FormItem>
                              <FormLabel className="text-slate-300">
                                Cookie Value
                              </FormLabel>
                              <FormControl>
                                <Input
                                  placeholder="e.g. abc123def456..."
                                  className="bg-slate-800 border-slate-700 text-white placeholder:text-slate-500"
                                  {...field}
                                />
                              </FormControl>
                              <FormMessage />
                            </FormItem>
                          )}
                        />
                      </div>
                    )}

                    {/* Selenium Auth */}
                    {watchAuthType === "selenium" && (
                      <div className="space-y-4">
                        <FormField
                          control={form.control}
                          name="username"
                          render={({ field }) => (
                            <FormItem>
                              <FormLabel className="text-slate-300">
                                Login URL
                              </FormLabel>
                              <FormControl>
                                <Input
                                  placeholder="https://example.com/login"
                                  className="bg-slate-800 border-slate-700 text-white placeholder:text-slate-500"
                                  {...field}
                                />
                              </FormControl>
                              <FormMessage />
                            </FormItem>
                          )}
                        />
                        <div className="grid grid-cols-2 gap-4">
                          <FormField
                            control={form.control}
                            name="password"
                            render={({ field }) => (
                              <FormItem>
                                <FormLabel className="text-slate-300">
                                  Username Selector
                                </FormLabel>
                                <FormControl>
                                  <Input
                                    placeholder="e.g. #username"
                                    className="bg-slate-800 border-slate-700 text-white placeholder:text-slate-500"
                                    {...field}
                                  />
                                </FormControl>
                                <FormMessage />
                              </FormItem>
                            )}
                          />
                          <FormField
                            control={form.control}
                            name="privateKey"
                            render={({ field }) => (
                              <FormItem>
                                <FormLabel className="text-slate-300">
                                  Password Selector
                                </FormLabel>
                                <FormControl>
                                  <Input
                                    placeholder="e.g. #password"
                                    className="bg-slate-800 border-slate-700 text-white placeholder:text-slate-500"
                                    {...field}
                                  />
                                </FormControl>
                                <FormMessage />
                              </FormItem>
                            )}
                          />
                        </div>
                        <FormField
                          control={form.control}
                          name="description"
                          render={({ field }) => (
                            <FormItem>
                              <FormLabel className="text-slate-300">
                                Submit Button Selector
                              </FormLabel>
                              <FormControl>
                                <Input
                                  placeholder="e.g. button[type='submit']"
                                  className="bg-slate-800 border-slate-700 text-white placeholder:text-slate-500"
                                  {...field}
                                />
                              </FormControl>
                              <FormDescription className="text-slate-500">
                                Selenium will automate browser login using
                                these selectors
                              </FormDescription>
                              <FormMessage />
                            </FormItem>
                          )}
                        />
                      </div>
                    )}
                  </CardContent>
                )}
              </Card>
            </div>
          </div>

          {/* Actions (full width) */}
          <div className="flex justify-end gap-3 pt-4 border-t border-slate-800">
            <Button
              type="button"
              variant="outline"
              className="border-slate-700 text-slate-300 hover:bg-slate-800"
              onClick={() => navigate(-1)}
            >
              Cancel
            </Button>
            <Button type="submit" className="bg-blue-600 hover:bg-blue-700">
              Launch Scan
            </Button>
          </div>
        </form>
      </Form>
    </div>
  );
}