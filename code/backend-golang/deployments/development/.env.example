# Development Environment Variables
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Database Configuration
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=devuser
DATABASE_PASSWORD=devpass
DATABASE_NAME=scanner_dev
DATABASE_SSLMODE=disable

# Worker Configuration
WORKER_POOL_SIZE=10

# Scanner Configuration
SCANNER_CHROMIUM_PATH=/usr/bin/chromium
SCANNER_TIMEOUT_SEC=15
SCANNER_HEADLESS_SIZE=10

# AuthScan Configuration
AUTHSCAN_SESSION_CHECK_INTERVAL=30
AUTHSCAN_VERIFY_TIMEOUT=10
AUTHSCAN_MAX_RETRIES=3

# Report Configuration
REPORT_OUTPUT_DIR=./reports

# Template Configuration
TEMPLATE_DIR=./templates

# RabbitMQ Configuration (uses compose service name)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin
RABBITMQ_VHOST=/
RABBITMQ_PREFETCH_COUNT=10
RABBITMQ_HEARTBEAT=30
RABBITMQ_CONNECTION_TIMEOUT=5
RABBITMQ_MAX_RETRIES=3
RABBITMQ_RETRY_DELAY_MS=30000

# Auto-scale (optional — disabled by default)
# RABBITMQ_AUTOSCALE_ENABLED=true
# RABBITMQ_AUTOSCALE_MIN_WORKERS=5
# RABBITMQ_AUTOSCALE_MAX_WORKERS=100
# RABBITMQ_AUTOSCALE_SCALE_UP_THRESHOLD=5
# RABBITMQ_AUTOSCALE_SCALE_DOWN_THRESHOLD=1
