// SentinelScan Complete ERD
// Paste this into https://dbdiagram.io for visualization
// Updated: 2026-05-04 - Added proper users table with role & permissions (Simple RBAC)

Table users {
  id int [pk, increment]
  username varchar(50) [unique, not null]
  email varchar(100) [unique, not null]
  password_hash varchar(255) [not null]
  
  // Role-based access control (matches frontend auth.ts)
  role varchar(20) [not null, default: 'user']
  // JSONB stores permissions array: ["scan_create", "scan_view", ...]
  // If NULL, use default permissions from role matrix
  permissions jsonb
  
  // Profile fields
  first_name varchar(50)
  last_name varchar(50)
  
  // Account status
  is_active boolean [not null, default: true]
  last_login timestamp
  
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  Indexes {
    username [unique]
    email [unique]
    role
    is_active
  }
}

Table scan_jobs {
  id int [pk, increment]
  created_by int [not null]
  targets jsonb [not null]
  template_selectors jsonb
  status varchar(50) [not null, default: 'pending']
  progress int [not null, default: 0]
  total_tasks int [not null, default: 0]
  completed_tasks int [not null, default: 0]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  Indexes {
    status
    created_by
    created_at
  }
}

Table scan_results {
  id int [pk, increment]
  scan_id int [not null]
  target varchar(255) [not null]
  template_id varchar(255) [not null]
  severity varchar(50)
  finding jsonb [not null]
  created_at timestamp [not null, default: `now()`]

  Indexes {
    scan_id
    template_id
    severity
  }
}

Table tickets {
  id int [pk, increment]
  created_by int [not null]
  assigned_to int
  scan_result_id int
  title varchar(255) [not null]
  description text
  status varchar(50) [not null, default: 'open']
  severity varchar(50) [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  Indexes {
    status
    created_by
    assigned_to
  }
}

Table audit_logs {
  id int [pk, increment]
  user_id int
  level varchar(20) [not null]
  category varchar(50) [not null]
  action varchar(100) [not null]
  message text [not null]
  metadata jsonb
  created_at timestamp [not null, default: `now()`]

  Indexes {
    user_id
    level
    category
    created_at
  }
}

Table templates {
  id int [pk, increment]
  template_id varchar(255) [unique, not null]
  name varchar(255) [not null]
  severity varchar(50)
  tags jsonb
  content text [not null]
  version varchar(50)
  created_at timestamp [not null, default: `now()`]

  Indexes {
    template_id [unique]
    severity
    tags
  }
}

Table targets {
  id int [pk, increment]
  address varchar(255) [unique, not null]
  metadata jsonb
  created_at timestamp [not null, default: `now()`]

  Indexes {
    address [unique]
  }
}

// Junction table for Many-to-Many: Scan Jobs <-> Targets
Table scan_targets {
  scan_id int [not null]
  target_id int [not null]

  Indexes {
    scan_id
    target_id
    (scan_id, target_id) [pk]
  }
}

// ─── RELATIONSHIPS ─────────────────────────────────────

// Users relationships
Ref: scan_jobs.created_by > users.id
Ref: tickets.created_by > users.id
Ref: tickets.assigned_to > users.id
Ref: audit_logs.user_id > users.id

// Scan Jobs relationships
Ref: scan_results.scan_id > scan_jobs.id

// Tickets relationships
Ref: tickets.scan_result_id > scan_results.id

// Scan-Targets Junction (Many-to-Many)
Ref: scan_targets.scan_id > scan_jobs.id
Ref: scan_targets.target_id > targets.id
